# ---- Server ----
PORT=3000
# Comma-separated list of allowed web origins, or * for any
CORS_ORIGINS=*

# ---- Firebase (user store + auth verification) ----
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Use ONE of the following:
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON=<raw JSON or base64 of the JSON>   (handy on Render/Railway/Fly)
# FIREBASE_PROJECT_ID=unichat-xxxxx                                 (with Application Default Credentials)

# Local development without Firebase: skips token verification, keeps data in memory.
# Clients then send tokens like  dev:<uid>:<email>:<name>.  NEVER enable in production.
DEV_AUTH=false

# ---- AI assistant ----
# openai | anthropic | mock
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_BOT_NAME=UniChat AI
# Messages in a group/project room starting with this get an AI reply in the room
AI_ROOM_TRIGGER=@ai
AI_MAX_HISTORY=20
AI_MAX_TOKENS=1024
# AI_SYSTEM_PROMPT=You are UniChat Assistant...

# ---- Chat ----
CHAT_HISTORY_LIMIT=50
CHAT_MAX_MESSAGE_LENGTH=4000
